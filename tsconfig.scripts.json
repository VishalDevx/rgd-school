{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2021", "dom"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["script/**/*.ts", "lib/**/*.ts", "models/**/*.ts"],
  "exclude": ["node_modules"]
}